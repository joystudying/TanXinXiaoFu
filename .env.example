# 复制为 .env 后填写。这个文件会进 git，所以里面只有占位符，没有真密钥。
# 真实密钥写进 .env（被 .gitignore 忽略，不会进仓库）。

# ===== LLM（扮演学生）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-在这里填你的key
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_S=20
MODEL_MAX_TOKENS=200
TEMPERATURE=0.8
CTX_MAX_TURNS=8

# ===== ASR（语音识别）=====
# stub   = 未接入（前端打字，或用浏览器自带识别）
# funasr = 调本地 FunASR：先跑 backend/services/funasr_server.py
#          （端口 8001，需 Python 3.10/3.11 独立环境）
ASR_PROVIDER=stub
FUNASR_SERVICE_URL=http://127.0.0.1:8001/transcribe

# ===== TTS（语音合成）=====
# edge = 微软在线神经音色（免费、无需密钥）；stub = 不发声
TTS_PROVIDER=edge
# 云希：年轻男声，贴合大学生角色；女声可用 zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+4%

# ===== 存储 =====
DB_PATH=data/tanxin.db

# ===== 服务 =====
ALLOW_ORIGINS=http://127.0.0.1:8000
