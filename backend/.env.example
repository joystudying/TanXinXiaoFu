# ===== LLM（扮演学生）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== ASR =====
# stub = 未接入（先跑文字对练）；funasr = 调用本地 FunASR 服务
ASR_PROVIDER=stub
FUNASR_SERVICE_URL=http://127.0.0.1:8001/transcribe

# ===== TTS =====
# edge = edge-tts（免费、无需 GPU，先用它过渡）；stub = 不发声
TTS_PROVIDER=edge
# 学生音色，可换：zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural 等
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ===== 存储 =====
# 默认 SQLite（开箱即用）；换成 PostgreSQL：postgresql+asyncpg://user:pwd@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
