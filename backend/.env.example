# ===== LLM（扮演学生）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== ASR =====
# stub = 未接入（先跑文字对练）；funasr = 调用本地 FunASR 服务
ASR_PROVIDER=stub
FUNASR_SERVICE_URL=http://127.0.0.1:8001/transcribe

# ===== TTS =====
# edge = edge-tts（免费、无需 GPU，先用它过渡）；stub = 不发声
TTS_PROVIDER=edge
# 学生音色，可换：zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural 等
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ===== Evaluator（评价大模型，角色与评价分离）=====
EVALUATOR_PROVIDER=deepseek
EVALUATOR_MODEL=deepseek-chat
# 可换成 deepseek-reasoner（推理更强、更慢）；评价非实时，慢一点没关系

# ===== 实时语音（可选，火山豆包实时语音模型 3.0 全双工）=====
# 不配则只走回合制；填上 App ID + API Key 即可在谈话页切换真双工
VOLC_APP_ID=
VOLC_API_KEY=
VOLC_MODEL=1.2.6.0
VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# 学生音色（女生）；可选 zh_female_vv_jupiter_bigtts / zh_female_xiaohe_jupiter_bigtts
VOLC_SPEAKER=zh_female_vv_jupiter_bigtts

# ===== 案例检索（关键词 + 语义混合）=====
# embedding 用本地 BGE（离线无密钥）；向量库用 Qdrant 本地嵌入式模式
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTORSTORE_PROVIDER=qdrant
QDRANT_PATH=./data/qdrant

# ===== 存储 =====
# 默认 SQLite（开箱即用）；换成 PostgreSQL：postgresql+asyncpg://user:pwd@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
