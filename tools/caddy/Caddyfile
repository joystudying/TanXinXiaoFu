# 谈心小辅 —— Caddy 反向代理（纯 HTTP，本机使用）
# 两件事：1) 发静态页面；2) /ws/chat 与 /sessions 转发到 FastAPI（127.0.0.1:8000）。
{
	admin off
}

:5180 {
	handle /ws/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /sessions {
		reverse_proxy 127.0.0.1:8000
	}
	handle /sessions/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * C:/Users/13008/Desktop/AI语音对话/frontend
		file_server
	}
}
